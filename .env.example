# ====================================================================
# CelebrAI - Environment Configuration Template
# Copy this file to .env and provide your Gemini API key if available.
# The application can also run in Demo Mode if GEMINI_API_KEY is omitted.
# ====================================================================

# Port for the Node/Express backend server
PORT=3001

# Node environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Official Google Gemini API Key
# Obtain from: https://aistudio.google.com/app/apikey
# Leave empty to run in interactive Demo Mode with sample plans
GEMINI_API_KEY=

# Supported Gemini model identifier (e.g., gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Frontend client URL for CORS restrictions (comma-separated for multiples)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3001

# Database file location (SQLite)
DATABASE_PATH=./data/celebrai.db

# API Rate Limiter Window (in milliseconds, default 15 mins)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per rate limit window for AI generation endpoint
RATE_LIMIT_MAX_AI_REQUESTS=25
